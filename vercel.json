{
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        {
            "src": "/assets/webFonts/MoonTimeRegular/(.*)",
            "dest": "/assets/webFonts/MoonTimeRegular/$1"
        },
        {
            "src": "/assets/videos/(.*)",
            "dest": "/assets/videos/$1"
        },
        {
            "src": "/assets/css/(.*)",
            "dest": "/assets/css/$1"
        },
        {
            "src": "/assets/js/(.*)",
            "dest": "/assets/js/$1"
        },
        {
            "src": "/assets/img/(.*)",
            "dest": "/assets/img/$1"
        },
        {
            "src": "/components/(.*)",
            "dest": "/components/$1"
        },
        {
            "src": "/sitemap.xml",
            "dest": "/sitemap.xml"
        },
        {
            "src": "/robots.txt",
            "dest": "/robots.txt"
        },
        {
            "src": "/favicon.ico",
            "dest": "/favicon.ico"
        },
        {
            "src": "/favicon-32x32.png",
            "dest": "/favicon-32x32.png"
        },
        {
            "src": "/apple-touch-icon.png",
            "dest": "/apple-touch-icon.png"
        },
        {
            "src": "/site.webmanifest",
            "dest": "/site.webmanifest"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}